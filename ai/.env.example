# ai/.env.example — copy to ai/.env and fill in. Never commit ai/.env.
# Model names and secrets are read only from here; never hardcode them in Python.

# ── Credentials ──────────────────────────────────────────────
OPENAI_API_KEY=

# ── Models ───────────────────────────────────────────────────
# Primary reader for page sorting and section extraction.
EXTRACTION_MODEL=gpt-5.6-luna
# Second opinion on rules chunks only. Leave empty to disable the witness pass.
WITNESS_MODEL=gpt-5.6-terra

# ── Rendering ────────────────────────────────────────────────
# Low resolution for page classification, high resolution for extraction.
PDF_DPI_SORT=100
PDF_DPI_EXTRACT=250

# ── Pipeline behaviour ───────────────────────────────────────
# Bounded async fan-out across extraction chunks.
MAX_CONCURRENCY=4
# RapidFuzz ratio (0-100) for matching duplicate evidence quotes across overlapping chunks.
FUZZ_THRESHOLD=90
# live = call the model · stub = canned fixtures · replay = serve cached real outputs.
AI_MODE=live
# sha256-keyed extraction cache; also the source for replay mode.
EXTRACTION_CACHE=on
