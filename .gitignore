# ---------------------------------------------------------------------------
# YetkiCheck — repository ignore rules
# See docs/fbdocs/IMPLEMENTATION_PLAN.md section 4.1 for the required layout.
# Rule of thumb: committed = reproducible demo input. Ignored = runtime state.
# ---------------------------------------------------------------------------

# --- secrets & local environment -------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key

# --- python / api -----------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# --- databases (runtime state) ---------------------------------------------
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# --- node / web -------------------------------------------------------------
node_modules/
.next/
out/
dist/
coverage/
.turbo/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*

# --- runtime data (regenerated by scripts/reset_demo.*) ---------------------
# data/registry.json is GENERATED from data/registry.seed.json at reset time.
data/registry.json
# Uploaded documents and their rendered pages are runtime artefacts.
data/uploads/*
!data/uploads/.gitkeep

# --- deliberately NOT ignored ----------------------------------------------
# data/fixtures/**            committed golden input for stub + tests
# data/documents/**           committed synthetic PDFs and page PNGs
# data/registry.seed.json     committed baseline registry
# data/cache/extractions/**   pre-warmed validated live responses; these must
#                             survive to the stage so replay works offline
#                             (IMPLEMENTATION_PLAN.md GAP-11, phases 6-8).

# --- editor / os ------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
