# YetkiCheck bank API — copy to api/.env and adjust locally.
# No real keys and no machine-specific absolute paths belong in this file.
# Model credentials are AI-engineer-owned and never live here.

APP_ENV=development

# Guards every demo-only mutation endpoint (plan section 14).
DEMO_MODE=true

DATABASE_URL=sqlite:///./yetkicheck.db

# The externally owned AI service. This track configures the URL and verifies
# connectivity; it never starts, stops or edits that service (plan section 18.11).
AI_URL=http://localhost:8001

# stub   committed golden fixtures, with an optional short artificial delay
# live   call the AI service
# replay return a cached live response selected by document SHA-256
# An unknown value must fail application startup with a clear configuration
# error (plan section 4.3). Stage policy is live + cache on (GAP-11).
AI_MODE=stub

# The extraction cache is owned by the bank API, not by the AI service.
EXTRACTION_CACHE=on

AI_TIMEOUT_SECONDS=20

# Relative to the api/ working directory so the repo stays portable.
DATA_DIR=../data

# CORS allowlist — the frontend origin only (plan section 14).
ALLOWED_ORIGINS=http://localhost:3000

MAX_UPLOAD_MB=20
